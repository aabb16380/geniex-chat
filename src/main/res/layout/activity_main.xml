<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- ==================== 主界面 ==================== -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="20dp"
        android:background="@color/bg_normal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="52dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="12dp"
                    android:paddingRight="14dp">

                    <ImageButton
                        android:id="@+id/btn_menu"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="菜单"
                        android:scaleType="centerInside"
                        android:src="@android:drawable/ic_menu_sort_by_size" />

                    <TextView
                        android:id="@+id/tv_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="于神本地模型"
                        android:textColor="#1F1F1F"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <!-- 会话标题放在标题右侧 -->
                    <TextView
                        android:id="@+id/tv_session_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:maxLines="1"
                        android:text="新对话"
                        android:textColor="#9A9A9A"
                        android:textSize="12sp" />
                </LinearLayout>

                <View
                    android:id="@+id/v_tip"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- 运行时内存条：灰=系统/其他，蓝=模型 -->
            <LinearLayout
                android:id="@+id/ll_memory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="12dp"
                android:paddingTop="2dp"
                android:paddingRight="8dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:id="@+id/ll_mem_bar"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_mem_track"
                    android:orientation="horizontal"
                    android:weightSum="100">

                    <View
                        android:id="@+id/v_mem_sys"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0"
                        android:background="#9AA3B2" />

                    <View
                        android:id="@+id/v_mem_model"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0"
                        android:background="#2F6BFF" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_mem_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="--"
                    android:textColor="#5A6B85"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_clean_memory"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/btn_rounded_border"
                    android:minWidth="0dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:text="@string/clean_memory"
                    android:textAllCaps="false"
                    android:textColor="#1F1F1F"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_downloading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F3F6FB"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="12dp"
                android:paddingTop="6dp"
                android:paddingRight="8dp"
                android:paddingBottom="6dp"
                android:visibility="gone"
                tools:visibility="visible">

                <FrameLayout
                    android:id="@+id/fl_download_track"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_download_track" />

                    <View
                        android:id="@+id/v_download_fill"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_download_fill" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_download_progress"
                    android:layout_width="158dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="end|center_vertical"
                    android:lineSpacingExtra="-2dp"
                    android:maxLines="3"
                    android:text="0 MB"
                    android:textColor="#5A6B85"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_cancel_download"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/btn_rounded_border"
                    android:minWidth="0dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="取消"
                    android:textAllCaps="false"
                    android:textColor="#1F1F1F"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_retry_download"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/btn_rounded_border"
                    android:minWidth="0dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="重试"
                    android:textAllCaps="false"
                    android:textColor="#1F1F1F"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_load_model"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/btn_rounded_border"
                    android:text="加载"
                    android:textAllCaps="false"
                    android:textColor="#1F1F1F" />

                <Button
                    android:id="@+id/btn_select_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/btn_rounded_border"
                    android:text="@string/select_mode"
                    android:textAllCaps="false"
                    android:textColor="#1F1F1F" />

                <Button
                    android:id="@+id/btn_unload_model"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/btn_rounded_border"
                    android:text="卸载"
                    android:textAllCaps="false"
                    android:textColor="#1F1F1F"
                    android:visibility="gone"
                    tools:visibility="gone" />

                <Button
                    android:id="@+id/btn_stop"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/btn_rounded_border"
                    android:text="停止"
                    android:textAllCaps="false"
                    android:textColor="#1F1F1F"
                    android:visibility="gone"
                    tools:visibility="gone" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:background="#E7E7E7" />

            <Button
                android:id="@+id/btn_test"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="test"
                android:visibility="gone" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_chat"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:clipToPadding="false"
                        android:padding="8dp"
                        android:scrollbars="vertical"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input_box_background"
                        android:orientation="vertical"
                        android:paddingLeft="8dp"
                        android:paddingTop="6dp"
                        android:paddingRight="8dp">

                        <HorizontalScrollView
                            android:id="@+id/scroll_images"
                            android:layout_width="match_parent"
                            android:layout_height="100dp"
                            android:layout_margin="6dp"
                            android:overScrollMode="never"
                            android:visibility="gone">

                            <LinearLayout
                                android:id="@+id/ll_images_container"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_marginLeft="6dp"
                                android:layout_marginEnd="6dp"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>

                        <TextView
                            android:id="@+id/btn_resend"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/btn_rounded_border"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingLeft="10dp"
                            android:paddingTop="4dp"
                            android:paddingRight="10dp"
                            android:paddingBottom="4dp"
                            android:text="@string/resend_hint"
                            android:textColor="#2F6BFF"
                            android:textSize="11sp"
                            android:visibility="gone" />

                        <EditText
                            android:id="@+id/et_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="6dp"
                            android:background="@null"
                            android:hint="输入内容…"
                            android:imeOptions="actionSend"
                            android:inputType="text"
                            android:padding="6dp"
                            android:textColorHint="#ADADAD" />

                        <LinearLayout
                            android:id="@+id/ll_selection_bar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:visibility="gone">

                            <Button
                                android:id="@+id/btn_sel_cancel"
                                android:layout_width="0dp"
                                android:layout_height="32dp"
                                android:layout_marginLeft="4dp"
                                android:layout_marginRight="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/btn_rounded_border"
                                android:text="@string/cancel"
                                android:textAllCaps="false"
                                android:textColor="#1F1F1F" />

                            <Button
                                android:id="@+id/btn_sel_delete"
                                android:layout_width="0dp"
                                android:layout_height="32dp"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1"
                                android:background="@drawable/btn_rounded_border"
                                android:text="@string/delete"
                                android:textAllCaps="false"
                                android:textColor="#1F1F1F" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/ll_input_actions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp">

                            <Button
                                android:id="@+id/btn_add_image"
                                android:layout_width="36dp"
                                android:layout_height="32dp"
                                android:layout_marginLeft="0dp"
                                android:layout_marginRight="6dp"
                                android:background="@drawable/btn_rounded_border"
                                android:gravity="center"
                                android:minWidth="0dp"
                                android:paddingLeft="0dp"
                                android:paddingRight="0dp"
                                android:text="+"
                                android:textAllCaps="false"
                                android:textColor="#1F1F1F"
                                android:textSize="18sp" />

                            <!-- 单次输出上限（左下角） -->
                            <Button
                                android:id="@+id/btn_max_output"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:layout_marginLeft="4dp"
                                android:layout_marginRight="4dp"
                                android:background="@drawable/btn_rounded_border"
                                android:minWidth="0dp"
                                android:paddingLeft="10dp"
                                android:paddingRight="10dp"
                                android:text="输出 2048"
                                android:textAllCaps="false"
                                android:textColor="#1F1F1F"
                                android:textSize="11sp" />

                            

                            <!-- 当前对话 token 统计 -->
                            <TextView
                                android:id="@+id/tv_token_count"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:layout_marginLeft="4dp"
                                android:layout_marginRight="6dp"
                                android:background="@drawable/btn_rounded_border"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:paddingLeft="8dp"
                                android:paddingRight="8dp"
                                android:text="0 tok"
                                android:textColor="#5A6B85"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tv_model_chip"
                                android:layout_width="0dp"
                                android:layout_height="32dp"
                                android:layout_marginLeft="0dp"
                                android:layout_marginRight="6dp"
                                android:layout_weight="2.6"
                                android:background="@drawable/btn_rounded_border"
                                android:clickable="true"
                                android:ellipsize="end"
                                android:focusable="true"
                                android:gravity="center"
                                android:paddingLeft="8dp"
                                android:paddingRight="8dp"
                                android:singleLine="true"
                                android:text="选择模型"
                                android:textColor="#1F1F1F"
                                android:textSize="12sp" />

                            <Button
                                android:id="@+id/btn_send"
                                android:layout_width="0dp"
                                android:layout_height="32dp"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_send_blue"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:text="发送"
                                android:textAllCaps="false"
                                android:textColor="#FFFFFF" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="92dp"
            android:background="@drawable/bg_hint_black"
            android:elevation="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingTop="10dp"
            android:paddingRight="18dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_hint_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="icon"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:id="@+id/tv_hint_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="invisible"
            tools:visibility="gone">

            <LinearLayout
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_popup_menu"
                android:elevation="10dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingLeft="22dp"
                android:paddingTop="20dp"
                android:paddingRight="22dp"
                android:paddingBottom="20dp">

                <TextView
                    android:id="@+id/tv_loading_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="正在加载模型"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_loading_model"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="#8A8A8A"
                    android:textSize="12sp" />

                <ProgressBar
                    android:id="@+id/pb_loading"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="16dp"
                    android:indeterminate="true" />

                <TextView
                    android:id="@+id/tv_loading_elapsed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="0.0 s"
                    android:textColor="#B0B0B0"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

    </RelativeLayout>

    <!-- ==================== 左侧抽屉 ==================== -->
    <LinearLayout
        android:id="@+id/drawer_panel"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FFFFFF"
        android:clickable="true"
        android:elevation="8dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="10dp"
            android:text="会话"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_new_chat"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/btn_rounded_border"
            android:minHeight="0dp"
            android:text="＋ 新对话"
            android:textAllCaps="false"
            android:textColor="#1F1F1F"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_download"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/btn_rounded_border"
            android:minHeight="0dp"
            android:text="模型管理"
            android:textAllCaps="false"
            android:textColor="#1F1F1F"
            android:textSize="12sp" />
        <Button
            android:id="@+id/btn_kb"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/btn_rounded_border"
            android:minHeight="0dp"
            android:text="数据库管理"
            android:textAllCaps="false"
            android:textColor="#1F1F1F"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="20dp"
            android:background="#E7E7E7" />

        <TextView
            android:id="@+id/tv_device_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:text="设备"
            android:textColor="#1F1F1F"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="20dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CPU"
                    android:textColor="#1F1F1F"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_cpu_model"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="--"
                    android:textColor="#6B6B6B"
                    android:textSize="10sp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#DDDDDD" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GPU"
                    android:textColor="#1F1F1F"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_gpu_model"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="--"
                    android:textColor="#6B6B6B"
                    android:textSize="10sp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#DDDDDD" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NPU"
                    android:textColor="#1F1F1F"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_npu_model"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="--"
                    android:textColor="#6B6B6B"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_recommend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="20dp"
            android:text="推荐：--"
            android:textColor="#2F6BFF"
            android:textSize="11sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="20dp"
